# ── Supabase ──────────────────────────────────────────────────────────
# Found in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── App ───────────────────────────────────────────────────────────────
# The public URL this app is deployed at. Used to build the OAuth
# redirect URL. Use http://localhost:3000 for local development and
# your Vercel URL (or custom domain) in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
